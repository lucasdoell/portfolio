---
interface Props {
  class?: string;
}

type EntryKind = "work" | "school";

interface Entry {
  kind: EntryKind;
  year: string;
  span: string;
  title: string;
  org: string;
  location: string;
  bullets: string[];
  current?: boolean;
}

const { class: className } = Astro.props;

const entries: Entry[] = [
  {
    kind: "work",
    year: "2026",
    span: "Jan 2026 — Present",
    title: "Software Engineering Team Lead",
    org: "New Jersey Dept. of Community Affairs · Data Center",
    location: "Trenton, NJ",
    current: true,
    bullets: [
      "Supporting the technical migration of NJ HMIS from the NJ Housing and Mortgage Finance Agency to DCA — building the replacement public-facing site and deploying a candidate vendor platform to AWS for procurement evaluation.",
      "Led the NJ Eviction Guide V2 rewrite from Vite/React to Next.js + shadcn/ui, including go-live readiness and pre-launch SEO tooling via Google Search Console and Bing Webmaster Tools.",
      "Built a municipal photo ingestion platform for the NJ HOMES Choice Tool (Next.js, AWS S3) with automated SES email confirmations, replacing a manual SimpliGov-based workflow.",
    ],
  },
  {
    kind: "work",
    year: "2025",
    span: "Sep 2025 — Dec 2025",
    title: "Full-Stack Software Engineer",
    org: "New Jersey Dept. of Community Affairs · Data Center",
    location: "Trenton, NJ",
    bullets: [
      "Built a CSV schema validation tool for the NJ Bringing Veterans Home data pipeline (Next.js) — parsing submissions, rendering field-level errors inline, and reducing ingestion failures from municipal partners.",
      "Delivered the initial DCAid benefits eligibility platform on AWS App Runner (Next.js), including a multi-step screening workflow, crisis triage routing, and a filterable program directory — from zero to deployed in under two weeks.",
      "Designed and shipped a Kanban-style affordable housing project planner for the NJ HOMES Choice Tool within a week of the Assistant Commissioner's request, enabling municipalities to track Mount Laurel obligations with CSV export and print reporting.",
    ],
  },
  {
    kind: "work",
    year: "2025",
    span: "Jun 2025 — Aug 2025",
    title: "Frontend Web Development Intern",
    org: "New Jersey Dept. of Community Affairs · Data Center",
    location: "Trenton, NJ",
    bullets: [
      "Built and maintained public-facing web applications in TypeScript, React, Astro, Next.js, and Vite under state accessibility guidelines.",
      "Spearheaded internationalization of the NJ Eviction Guide under the NJ State Language Access Mandate, and redesigned the NJ HOMES Choice Tool with a shopping cart flow for municipal planners.",
    ],
  },
  {
    kind: "work",
    year: "2023 —",
    span: "Nov 2023 — Present",
    title: "Founder & Lead Engineer",
    org: "lux.dev LLC · SaaS startup, data visualization",
    location: "Ewing, NJ",
    current: true,
    bullets: [
      "Launched Parsertime, an open-source Overwatch 2 analytics platform with 1,500+ users — processing 600,000+ kills and 1,100,000+ stats across 340 teams.",
      "Led and mentored a team of interns building features in React, Next.js, Tailwind, and Postgres.",
    ],
  },
  {
    kind: "work",
    year: "2025",
    span: "Feb 2025 — Aug 2025",
    title: "Senior Full-Stack Software Engineer",
    org: "NTMR Esports LLC · Esports web apps",
    location: "Miami, FL",
    bullets: [
      "Architected scalable, accessible frontend solutions in React + TypeScript while driving technical decisions for core application architecture.",
      "Mentored mid-level engineers and interns, leading a team to consistently deliver critical features against investor milestones.",
    ],
  },
  {
    kind: "work",
    year: "2023",
    span: "Feb 2023 — Dec 2023",
    title: "Full-Stack Software Engineer",
    org: "Appstle Inc. · SaaS, ecommerce merchants",
    location: "Sunnyvale, CA",
    bullets: [
      "Built commerce features for 30,000+ Shopify merchants and redesigned analytics for improved UX, reducing customer service interactions.",
    ],
  },
  {
    kind: "school",
    year: "2021",
    span: "Aug 2021 — May 2025",
    title: "B.A. Computer Science",
    org: "Cornell University · Minor in Artificial Intelligence",
    location: "Ithaca, NY",
    bullets: [
      "Bachelor of Arts in Computer Science with a minor in Artificial Intelligence.",
    ],
  },
];

let lastYear: string | null = null;
const rows = entries.map((e) => {
  const dupYear = e.year === lastYear;
  lastYear = e.year;
  return { ...e, dupYear };
});
---

<section
  id="experience"
  class:list={[
    "relative w-full",
    "px-6 sm:px-10 lg:px-14",
    "pt-24 sm:pt-32",
    "pb-24 sm:pb-32",
    className,
  ]}
  aria-labelledby="record-heading"
>
  <header class="mb-14 sm:mb-20">
    <div class="flex items-baseline justify-between gap-6 mb-6">
      <span class="meta">§ 02 &nbsp;&mdash;&nbsp; Record</span>
      <span class="meta">
        <span style="color: var(--color-fg-mute);">Entries</span>
        <span class="ml-1.5" style="color: var(--color-fg);">{rows.length.toString().padStart(2, "0")}</span>
      </span>
    </div>
    <hr class="rule" />
    <h2
      id="record-heading"
      class="display mt-8 sm:mt-10"
      style="
        font-size: var(--text-display-sm);
        font-weight: 480;
        max-width: 22ch;
      "
    >
      Work history &amp; education.
    </h2>
  </header>

  <ol class="ledger">
    {
      rows.map((e) => (
        <li class="ledger-row">
          <div class="ledger-row__year">
            {e.dupYear ? (
              <span class="meta" aria-hidden="true" style="opacity: 0;">{e.year}</span>
            ) : (
              <span class="meta" style="color: var(--color-fg);">{e.year}</span>
            )}
          </div>
          <div class="ledger-row__body">
            <div class="ledger-row__top">
              <div class="ledger-row__kind-chip">
                <span class="meta">
                  {e.kind === "work" ? "Role" : "School"}
                </span>
                {e.current && (
                  <span class="meta ledger-row__pulse" aria-label="Current">
                    <span aria-hidden="true" class="dot" />
                    Now
                  </span>
                )}
              </div>
              <span class="meta" style="color: var(--color-fg-mute);">
                {e.span} &nbsp;·&nbsp; {e.location}
              </span>
            </div>
            <h3 class="ledger-row__title">
              {e.title}
            </h3>
            <p class="ledger-row__org">
              {e.org}
            </p>
            <ul class="ledger-row__bullets">
              {e.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    column-gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.75rem, 3.5vw, 2.75rem) 0;
    border-bottom: 1px solid var(--color-rule);
    position: relative;
  }

  .ledger-row__year {
    padding-top: 0.3rem;
    position: sticky;
    top: 7rem;
    align-self: start;
    height: fit-content;
  }

  .ledger-row__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 70ch;
  }

  .ledger-row__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
    justify-content: space-between;
  }

  .ledger-row__kind-chip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ledger-row__pulse {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-fg);
  }

  .ledger-row__pulse .dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--color-accent) 20%, transparent);
    animation: pulse 2600ms ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-accent) 24%, transparent); }
    50% { box-shadow: 0 0 0 6px color-mix(in oklch, var(--color-accent) 0%, transparent); }
  }

  .ledger-row__title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.6vw + 0.75rem, 2.5rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-heading);
    color: var(--color-fg);
    margin: 0.1rem 0 0 0;
  }

  .ledger-row__org {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 0.5vw + 0.9rem, 1.25rem);
    color: var(--color-fg-soft);
    margin: 0;
    line-height: 1.3;
  }

  .ledger-row__bullets {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .ledger-row__bullets li {
    font-size: var(--text-body);
    color: var(--color-fg-soft);
    line-height: 1.5;
    padding-left: 1.25rem;
    position: relative;
  }
  .ledger-row__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.6rem;
    height: 1px;
    background: var(--color-fg-mute);
  }

  @media (max-width: 640px) {
    .ledger-row {
      grid-template-columns: 1fr;
      row-gap: 0.75rem;
    }
    .ledger-row__year {
      position: static;
      padding-top: 0;
    }
    .ledger-row__top {
      flex-direction: column;
      gap: 0.25rem;
      align-items: flex-start;
    }
  }
</style>
