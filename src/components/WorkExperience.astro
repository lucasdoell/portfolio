---
interface Props {
  class?: string;
}

interface Position {
  title: string;
  duration: string;
  location: string;
  description: string[];
}

interface WorkExperience {
  company: string;
  totalDuration?: string;
  positions: Position[];
}

const { class: className } = Astro.props;

const experiences: WorkExperience[] = [
  {
    company: "New Jersey Department of Community Affairs",
    totalDuration: "Jun 2025 - Present",
    positions: [
      {
        title: "Software Engineering Team Lead, DHCR Data Center",
        duration: "Jan 2026 - Present",
        location: "Trenton, New Jersey",
        description: [
          "Leading a team of developers within the Division of Housing and Community Resources' Data Center to redesign the DCAid frontend and CMS to create a modern, user-friendly interface for residents seeking state assistance programs.",
          "Developing internal AI tools deployed to Azure and Amazon Web Services using Next.js, Postgres, and other cutting-edge tools.",
          "Emphasizing high engineering standards through code review, tooling, and peer learning sessions.",
          "Implementing tools such as OpenTelemetry traces and Google Analytics dashboards to provide actionable insights into critical data.",
        ],
      },
      {
        title: "Full-Stack Software Engineer",
        duration: "Sep 2025 - Jan 2026",
        location: "Trenton, New Jersey",
        description: [
          "Redesigned the DCAid portal to create a modern, user-friendly interface for residents seeking state assistance programs.",
          "Developed a new public-facing website for DCA lead reporting initiatives, serving as a one-stop shop for all resources related to municipal lead reporting.",
        ],
      },
      {
        title: "Frontend Web Development Intern",
        duration: "Jun 2025 - Sep 2025",
        location: "Trenton, New Jersey",
        description: [
          "Developed and maintained public-facing static web applications using JavaScript, TypeScript, React, Astro, Next.js, and Vite while complying with state accessibility guidelines.",
          "Spearheaded internationalization of the NJ Eviction Guide project to comply with the NJ State Language Access Mandate.",
          "Redesigned the NJ HOMES Choice Tool to improve user experience and added new shopping cart functionality for municipal affordable housing projects.",
          "Led the development of a DCA AI Assistant tool, leveraging retrieval-augmented generation and large language models to create a centralized knowledge resource for DCA employees deployed to AWS GovCloud and Microsoft Azure AI Foundry.",
          "Established fundamental web engineering principles, including CI/CD pipelines, code linting, unit test suites, and style guides for uniformity and code quality, decreasing maintenance costs and increasing robustness and performance.",
        ],
      },
    ],
  },
  {
    company: "lux.dev LLC",
    positions: [
      {
        title: "Founder, Lead Engineer",
        duration: "Nov 2023 - Present",
        location: "Ithaca, New York",
        description: [
          "Launched Parsertime, an open-source app for Overwatch 2 data visualization with over 800 users.",
          "Developed and managed custom analytics and team management features, processing over 400,000 player kills and 700,000 player statistics across 150 teams, driving deeper insights and engagement for users.",
          "Led and educated a team of interns to develop software with React, Next.js, Tailwind, and PostgreSQL.",
          "Reduced churn and increased user satisfaction by providing community support and troubleshooting via Discord.",
          "Decreased support tickets by authoring technical docs to guide users on features, analytics setup, and issue resolution.",
        ],
      },
    ],
  },
  {
    company: "NTMR Esports",
    positions: [
      {
        title: "Senior Full-Stack Software Engineer",
        duration: "Feb 2025 - Aug 2025",
        location: "Miami, Florida",
        description: [
          "Led a team of frontend engineers to build scalable, accessible, and high-performance web applications using React and TypeScript.",
          "Was responsible for architecting front-end solutions, defining development standards and best practices, and ensuring alignment with investor milestones and deadlines.",
          "Actively mentored and upskilled engineers and interns, fostering expertise in modern web development.",
          "Drove technical decisions with a strong focus on user experience and engagement metrics to deliver impactful, data-driven features.",
        ],
      },
    ],
  },
  {
    company: "Appstle Inc.",
    positions: [
      {
        title: "Software Engineer",
        duration: "Feb 2023 - Dec 2023",
        location: "Sunnyvale, California",
        description: [
          "Built new commerce features for 30,000+ Shopify merchants.",
          "Redesigned analytics for improved UX, reducing customer service interactions.",
          "Leveraged Intercom customer outreach platform to reduce churn and lower subscription cancellations.",
          "Wrote and maintained clean code in Java and TypeScript for backend and frontend.",
          "Migrated legacy code from JavaScript to TypeScript, reducing bugs and boosting development speed.",
          "Developed internal tools to customize features for enterprise merchants.",
        ],
      },
    ],
  },
  {
    company: "AT&T Inc.",
    positions: [
      {
        title: "Connectivity Expert",
        duration: "May 2024 - Feb 2025",
        location: "Ithaca, New York",
        description: [
          "Effectively presented products and services to and develop relationships with potential clients.",
          "Exceeded sales goals by selling products and services to new and existing customers, consistently being a top performer in the upstate New York market.",
          "Stayed up to date with product knowledge, accessories, pricing plans, promotions, and service features.",
          "Prospected and built relationships with local small businesses to increase outreach.",
        ],
      },
    ],
  },
