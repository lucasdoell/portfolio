---

<section
  class:list={["w-full max-w-5xl mx-auto px-8 xl:px-0 py-24", className]}
  id="experience"
>
  <h2 class="text-3xl font-bold text-gray-950 dark:text-gray-50 mb-12">
    Work Experience
  </h2>
  <div class="space-y-16">
    {
      experiences.map((experience) => (
        <article class="border-b border-gray-200 dark:border-gray-800 pb-16 last:border-0">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-8">
            <div>
              <h3 class="text-2xl font-bold text-gray-950 dark:text-gray-50 mb-1">
                {experience.company}
              </h3>
              {experience.totalDuration && (
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  {experience.totalDuration}
                </p>
              )}
            </div>
          </div>
          <div class="space-y-10">
            {experience.positions.map((position) => (
              <div>
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
                  <div class="flex-1">
                    <h4 class="text-xl font-semibold text-gray-950 dark:text-gray-50">
                      {position.title}
                    </h4>
                  </div>
                  <div class="flex flex-col sm:text-right sm:items-end mt-1 sm:mt-0">
                    <time class="text-gray-600 dark:text-gray-400 text-sm" datetime={position.duration}>
                      {position.duration}
                    </time>
                    <span class="text-gray-600 dark:text-gray-400 text-sm">
                      {position.location}
                    </span>
                  </div>
                </div>
                <ul class="space-y-2">
                  {position.description.map((bullet) => (
                    <li class="text-gray-600 dark:text-gray-400 text-base">
                      • {bullet}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>
