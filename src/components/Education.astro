---
interface Props {
  class?: string;
}

interface EducationDetail {
  text: string;
  subItems?: string[];
}

interface Education {
  school: string;
  degree: string;
  duration: string;
  location: string;
  details: EducationDetail[];
}

const { class: className } = Astro.props;

const education: Education[] = [
  {
    school: "Cornell University",
    degree: "Bachelor of Arts in Computer Science",
    duration: "Aug 2021 - May 2025",
    location: "Ithaca, NY",
    details: [
      {
        text: "Minor in Artificial Intelligence",
      },
      {
        text: "Relevant coursework includes:",
        subItems: [
          "Introduction to Computing using Python",
          "Object-Oriented Programming and Data Structures",
          "Data Structures and Functional Programming",
          "Introductory Design and Programming for the Web",
          "Mathematical Foundations of Computing",
        ],
      },
    ],
  },
];
---

<section
  class:list={["w-full max-w-5xl mx-auto px-8 xl:px-0 py-24", className]}
  id="education"
>
  <h2 class="text-3xl font-bold text-gray-950 dark:text-gray-50 mb-12">
    Education
  </h2>
  <div class="space-y-12">
    {
      education.map((edu) => (
        <article class="border-b border-gray-200 dark:border-gray-800 pb-12 last:border-0">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-6">
            <div>
              <h3 class="text-2xl font-bold text-gray-950 dark:text-gray-50">
                {edu.school}
              </h3>
              <p class="text-neutral-700 dark:text-neutral-400 text-lg">
                {edu.degree}
              </p>
            </div>
            <div class="flex flex-col sm:text-right">
              <time class="text-gray-600 dark:text-gray-400" datetime="2021-08/2025-05">
                {edu.duration}
              </time>
              <span class="text-gray-600 dark:text-gray-400">
                {edu.location}
              </span>
            </div>
          </div>
          <ul class="space-y-3">
            {edu.details.map((detail) => (
              <li>
                <div class="text-gray-600 dark:text-gray-400 text-base">
                  {detail.text}
                </div>
                {detail.subItems && (
                  <ul class="mt-2 ml-6 space-y-2">
                    {detail.subItems.map((subItem) => (
                      <li class="text-gray-600 dark:text-gray-400 text-sm">
                        • {subItem}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
