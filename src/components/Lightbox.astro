---
// One shared dialog for every `img[data-zoom]` on the page.
---

<dialog class="lightbox" aria-label="Image viewer" data-lightbox>
  <button type="button" class="lightbox__close meta" data-lightbox-close>Close ✕</button>
  <figure class="lightbox__figure" tabindex="-1" autofocus>
    <img class="lightbox__img" alt="" />
    <figcaption class="lightbox__caption meta"></figcaption>
  </figure>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 64px);
    border: 0;
    /* The dialog covers the viewport itself, so the scrim doesn't depend on ::backdrop. */
    background: rgb(12 14 18 / 0.95);
    color: var(--color-frost);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox__figure {
    outline: none;
    margin: 0;
    max-width: min(1600px, 100%);
    max-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - clamp(16px, 4vw, 64px) * 2 - 40px);
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid #2a2d35;
    border-radius: 10px;
    cursor: zoom-out;
  }
  .lightbox__caption {
    color: var(--color-dusk);
  }
  .lightbox__close {
    position: fixed;
    top: 20px;
    right: clamp(16px, 4vw, 64px);
    background: none;
    border: 0;
    padding: 8px 0;
    color: var(--color-frost);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox__figure {
      animation: lightbox-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .lightbox[open] {
      animation: lightbox-fade 220ms ease-out;
    }
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  @keyframes lightbox-fade {
    from {
      opacity: 0;
    }
  }

  :global(img[data-zoom]) {
    cursor: zoom-in;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const big = dialog?.querySelector<HTMLImageElement>(".lightbox__img");
  const caption = dialog?.querySelector<HTMLElement>(".lightbox__caption");

  if (dialog && big && caption) {
    let opener: HTMLElement | null = null;

    const open = (img: HTMLImageElement) => {
      opener = img;
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      // Use the visible caption (theme-specific spans are hidden, so read rendered text).
      const fig = img.closest("figure")?.querySelector("figcaption");
      const parts = fig
        ? [...fig.children].filter((el) => getComputedStyle(el).display !== "none").map((el) => (el as HTMLElement).innerText.trim())
        : [];
      caption.textContent = parts.length ? parts.join(" · ") : (fig?.textContent?.trim() ?? "");
      caption.hidden = !caption.textContent;
      dialog.showModal();
    };
    const close = () => dialog.close();

    for (const img of document.querySelectorAll<HTMLImageElement>("img[data-zoom]")) {
      img.tabIndex = 0;
      img.setAttribute("role", "button");
      img.setAttribute("aria-haspopup", "dialog");
      img.addEventListener("click", () => open(img));
      img.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          open(img);
        }
      });
    }

    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", close);
    // Clicking anywhere outside the figure, or on the image itself, closes it.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog || e.target === big) close();
    });
    dialog.addEventListener("close", () => {
      opener?.focus();
      big.removeAttribute("src");
    });
  }
</script>
