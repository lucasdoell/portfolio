---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const year = new Date().getFullYear();
---

<section
  id="contact"
  class:list={[
    "relative w-full",
    "px-6 sm:px-10 lg:px-14",
    "pt-24 sm:pt-32",
    "pb-20",
    className,
  ]}
  aria-labelledby="contact-heading"
>
  <header class="mb-14 sm:mb-20">
    <div class="flex items-baseline justify-between gap-6 mb-6">
      <span class="meta">§ 03 &nbsp;&mdash;&nbsp; Contact</span>
      <span class="meta">
        <span style="color: var(--color-fg-mute);">Reply</span>
        <span class="ml-1.5" style="color: var(--color-fg);">Within 48h</span>
      </span>
    </div>
    <hr class="rule" />
  </header>

  <div class="contact-block">
    <p class="contact-lede">
      <span class="display contact-prompt">
        Currently taking on new work.
      </span>
    </p>
    <a href="mailto:lucas@lux.dev" class="contact-link group" aria-label="Email lucas@lux.dev">
      <span class="contact-link__label">lucas<span style="opacity: 0.5;">@</span>lux.dev</span>
      <span class="contact-link__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </a>
    <p class="contact-sub">
      Also at
      <a class="ink-link" href="https://github.com/lucasdoell" target="_blank" rel="noreferrer">GitHub</a>
      &nbsp;·&nbsp;
      <a class="ink-link" href="https://linkedin.com/in/lucasdoell" target="_blank" rel="noreferrer">LinkedIn</a>
      &nbsp;·&nbsp;
      <a class="ink-link" href="https://bsky.app/profile/lux.dev" target="_blank" rel="noreferrer">Bluesky</a>
      .
    </p>
  </div>
</section>

<footer
  class="w-full px-6 sm:px-10 lg:px-14 pt-8 pb-12 mt-8"
  style="border-top: 1px solid var(--color-rule);"
>
  <div class="colophon">
    <div>
      <span class="meta meta-fg">© {year} &nbsp;Lucas Doell</span>
      <span class="meta" style="margin-left: 0.8rem;">All rights, quietly reserved.</span>
    </div>
    <div class="colophon__line">
      <span class="meta">
        Set in
        <span class="meta meta-fg">Switzer</span>
        &nbsp;·&nbsp;
        <span class="serif-italic" style="color: var(--color-fg); font-size: 0.92em;">Gambetta</span>
        &nbsp;·&nbsp;
        <span class="meta meta-fg" style="font-family: var(--font-mono);">Geist&nbsp;Mono</span>
      </span>
    </div>
    <div>
      <span class="meta">
        Ewing · NJ
      </span>
      <span class="meta" style="margin-left: 0.8rem;">
        <a
          href="https://github.com/lucasdoell/portfolio"
          target="_blank"
          rel="noreferrer"
          class="ink-link"
        >Source</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .contact-block {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 3vw, 2.5rem);
    max-width: 55ch;
  }

  .contact-prompt {
    font-size: clamp(2.25rem, 6vw + 1rem, 5rem);
    font-weight: 480;
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
    color: var(--color-fg);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-sans);
    font-weight: 480;
    font-size: clamp(1.75rem, 4vw + 0.5rem, 3.5rem);
    letter-spacing: var(--tracking-heading);
    color: var(--color-fg);
    position: relative;
    padding: 0.25em 0;
    transition: color 320ms ease, transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    width: fit-content;
  }
  .contact-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.05em;
    height: 1.5px;
    background: currentColor;
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 640ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .contact-link:hover::after,
  .contact-link:focus-visible::after {
    transform: scaleX(1);
  }
  .contact-link:hover .contact-link__arrow,
  .contact-link:focus-visible .contact-link__arrow {
    transform: translateX(4px) rotate(-8deg);
    color: var(--color-accent);
  }
  .contact-link__arrow {
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1), color 260ms ease;
    font-size: 0.72em;
    display: inline-flex;
    align-items: center;
    margin-left: 0.1em;
  }

  .contact-sub {
    font-size: var(--text-body);
    color: var(--color-fg-soft);
    line-height: 1.5;
    max-width: 42ch;
  }

  .colophon {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .colophon > :nth-child(1) {
    justify-self: start;
  }
  .colophon > :nth-child(2) {
    justify-self: center;
    text-align: center;
  }
  .colophon > :nth-child(3) {
    justify-self: end;
    text-align: right;
  }

  @media (max-width: 640px) {
    .colophon {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      text-align: left;
    }
    .colophon > :nth-child(2),
    .colophon > :nth-child(3) {
      justify-self: start;
      text-align: left;
    }
  }
</style>
