---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  class:list={["w-full max-w-5xl mx-auto px-8 xl:px-0 py-24", className]}
>
  <div class="flex flex-col md:flex-row gap-12 items-start">
    <div class="flex-1">
      <h1 class="text-5xl font-bold mb-6 leading-tight">
        <span class="text-gray-950 dark:text-gray-50">
          Full-stack engineer building scalable, data-driven applications.
        </span>
      </h1>

      <p class="text-gray-600 dark:text-gray-400 text-lg mb-4 leading-relaxed">
        I lead a development team at the <span
          class="text-gray-950 dark:text-gray-50"
          >New Jersey Department of Community Affairs</span
        >, building tools that enhance accessibility and user experience—from
        internationalized eviction guides to AI-powered assistants.
      </p>

      <p class="text-gray-600 dark:text-gray-400 text-lg mb-4 leading-relaxed">
        As founder of <span class="text-gray-950 dark:text-gray-50"
          >lux.dev LLC</span
        >, I've built open-source platforms like Parsertime that serve gaming
        communities and provide detailed analytics for players and coaches.
      </p>

      <p class="text-gray-600 dark:text-gray-400 text-lg mb-8 leading-relaxed">
        I'm pursuing a B.A. in Computer Science with a minor in AI at <span
          class="text-gray-950 dark:text-gray-50">Cornell University</span
        >.
      </p>

      <div class="flex flex-row gap-4">
        <a
          href="#work"
          class="inline-flex items-center justify-center px-6 py-3 min-h-[44px] border border-gray-950 dark:border-gray-50 text-gray-950 dark:text-gray-50 text-base font-medium hover:bg-gray-950 hover:text-gray-50 dark:hover:bg-gray-50 dark:hover:text-gray-950 transition-colors"
        >
          View My Work
        </a>

        <a
          href="mailto:lucas@lux.dev"
          class="inline-flex items-center justify-center px-6 py-3 min-h-[44px] border border-gray-300 dark:border-gray-700 text-gray-600 dark:text-gray-400 text-base hover:border-gray-950 hover:text-gray-950 dark:hover:border-gray-50 dark:hover:text-gray-50 transition-colors"
        >
          Get in Touch
        </a>
      </div>
    </div>

    <div class="w-64 h-64 flex-shrink-0">
      <img
        src="/portrait.jpg"
        alt="Lucas Doell"
        class="w-full h-full object-cover rounded-lg"
      />
    </div>
  </div>
</section>
