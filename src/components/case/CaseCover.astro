---
// Typographic cover for case studies without pixel art.
interface Props {
  index: string;
  title: string;
  tagline: string;
}
const { index, title, tagline } = Astro.props;
---

<header class="cover wrap">
  <div class="cover__crumbs">
    <a class="meta meta--muted" href="/#work">← Logbook</a>
    <span class="meta">Case study {index}</span>
  </div>
  <h1 class="cover__title">{title}</h1>
  <p class="cover__tagline">{tagline}</p>
</header>

<style>
  .cover {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 72px;
    padding-bottom: 72px;
  }
  .cover__crumbs {
    display: flex;
    gap: 24px;
  }
  .cover__title {
    margin: 24px 0 0 -0.04em;
    font-weight: 500;
    font-size: clamp(64px, 11vw, 160px);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .cover__tagline {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(30px, 3vw, 44px);
    line-height: 1.18;
    letter-spacing: -0.01em;
  }
</style>
