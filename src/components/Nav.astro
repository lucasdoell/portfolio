---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<header
  class:list={[
    "fixed top-0 left-0 right-0 z-40",
    "px-6 sm:px-10 lg:px-14",
    "pt-6 pb-4",
    "pointer-events-none",
    className,
  ]}
  style="background: linear-gradient(to bottom, var(--color-ground) 55%, transparent 100%);"
>
  <div class="flex items-start justify-between pointer-events-auto">
    <a
      href="/"
      class="flex items-baseline gap-3 group"
      aria-label="Lucas Doell — home"
    >
      <span
        class="meta meta-fg font-medium"
        style="letter-spacing: 0.22em;"
        aria-hidden="true"
      >
        LD
      </span>
      <span
        class="meta"
        aria-hidden="true"
      >
        &mdash; Lucas Doell
      </span>
    </a>

    <div class="flex items-center gap-5 sm:gap-7">
      <nav
        aria-label="Primary"
        class="hidden sm:flex items-center gap-6"
      >
        <a href="#work" class="meta ink-link">
          <span class="meta" style="color: var(--color-fg-mute);">01</span>
          <span class="ml-1.5" style="color: var(--color-fg);">Work</span>
        </a>
        <a href="#experience" class="meta ink-link">
          <span class="meta" style="color: var(--color-fg-mute);">02</span>
          <span class="ml-1.5" style="color: var(--color-fg);">Record</span>
        </a>
        <a href="#contact" class="meta ink-link">
          <span class="meta" style="color: var(--color-fg-mute);">03</span>
          <span class="ml-1.5" style="color: var(--color-fg);">Contact</span>
        </a>
      </nav>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="meta relative inline-flex items-center gap-2 cursor-pointer"
      >
        <span class="meta" aria-hidden="true">
          <span data-theme-label="light">Day</span><span data-theme-label="dark" class="hidden">Night</span>
        </span>
        <span
          aria-hidden="true"
          class="inline-block w-2 h-2 rounded-full border"
          style="border-color: var(--color-fg-mute);"
          data-theme-dot
        ></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const STORAGE_KEY = "ld:theme";
    const root = document.documentElement;

    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");

    function resolve(mode) {
      if (mode === "dark" || mode === "light") return mode;
      return prefersDark.matches ? "dark" : "light";
    }

    function apply(mode) {
      const resolved = resolve(mode);
      root.setAttribute("data-theme", resolved);
      const lightLabel = document.querySelector('[data-theme-label="light"]');
      const darkLabel = document.querySelector('[data-theme-label="dark"]');
      if (lightLabel && darkLabel) {
        lightLabel.classList.toggle("hidden", resolved === "dark");
        darkLabel.classList.toggle("hidden", resolved === "light");
      }
      const dot = document.querySelector("[data-theme-dot]");
      if (dot) {
        dot.style.background =
          resolved === "dark" ? "var(--color-cream)" : "var(--color-ink)";
        dot.style.borderColor =
          resolved === "dark" ? "var(--color-cream)" : "var(--color-ink)";
      }
    }

    const stored = localStorage.getItem(STORAGE_KEY);
    apply(stored || (prefersDark.matches ? "dark" : "light"));

    const btn = document.getElementById("theme-toggle");
    if (btn) {
      btn.addEventListener("click", () => {
        const next =
          root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        localStorage.setItem(STORAGE_KEY, next);
        apply(next);
      });
    }

    prefersDark.addEventListener("change", (e) => {
      if (!localStorage.getItem(STORAGE_KEY)) apply(e.matches ? "dark" : "light");
    });
  })();
</script>
