---
import Star from "./Star.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/#work", label: "Work" },
  { href: "/writing", label: "Writing", current: path.startsWith("/writing") },
  { href: "/#contact", label: "Contact" },
];
---

<header class="nav wrap">
  <a href="/" class="nav__home meta" aria-label="Lucas Doell, home">
    <Star />
    <span>Lucas Doell</span>
  </a>
  <nav class="nav__links" aria-label="Primary">
    {
      links.map((l) => (
        <a href={l.href} class="meta" aria-current={l.current ? "page" : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="nav__end">
    <button type="button" class="theme-toggle meta" data-theme-toggle aria-label="Switch between day and night">
      <span class="theme-toggle__day">Day</span>
      <span aria-hidden="true">/</span>
      <span class="theme-toggle__night">Night</span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .nav::after {
    content: "";
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    border-bottom: 1px solid var(--line);
  }
  .nav__home,
  .nav__end {
    width: 320px;
    flex-shrink: 0;
  }
  .nav__home {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav__links {
    display: flex;
    gap: 36px;
  }
  .nav__links a[aria-current="page"] {
    color: var(--accent);
  }
  .nav__end {
    display: flex;
    justify-content: flex-end;
  }
  .theme-toggle {
    display: inline-flex;
    gap: 0.5em;
    color: var(--muted);
    cursor: pointer;
    background: none;
    border: 0;
    padding: 8px 0;
  }
  .theme-toggle__day {
    color: var(--fg);
  }
  :global(:root[data-theme="dark"]) .theme-toggle__day {
    color: var(--muted);
  }
  :global(:root[data-theme="dark"]) .theme-toggle__night {
    color: var(--fg);
  }

  @media (max-width: 900px) {
    .nav__home,
    .nav__end {
      width: auto;
    }
    .nav__links {
      gap: 20px;
    }
  }
  @media (max-width: 640px) {
    .nav__links {
      display: none;
    }
    .nav {
      height: 64px;
    }
  }
</style>

<script>
  // Mirrors the pre-paint script in Layout: stored choice wins, otherwise the system setting.
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  const current = () =>
    root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  for (const btn of toggles) {
    btn.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("ld:theme", next);
      } catch {}
      document.dispatchEvent(new CustomEvent("themechange", { detail: next }));
    });
  }
</script>
