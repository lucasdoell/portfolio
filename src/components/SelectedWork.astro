---
interface Props {
  class?: string;
}

interface Project {
  index: string;
  title: string;
  tagline: string;
  year: string;
  role: string;
  stack: string[];
  summary: string;
  href: string;
  caseStudyHref?: string;
}

const { class: className } = Astro.props;

const projects: Project[] = [
  {
    index: "N01",
    title: "ChatDCA",
    tagline: "A staff-facing AI agent platform for NJ state government.",
    year: "2025 —",
    role: "NJ DCA · Engineering",
    stack: ["eve", "AWS Bedrock", "Lambda", "Next.js"],
    summary:
      "A fleet of five agents built on eve, Vercel's agent framework, self-hosted in a locked-down AWS VPC with no internet egress: a Postgres-backed durable workflow runtime, sandboxed code execution in Bedrock AgentCore microVMs, and per-request model credentials. A router agent hands work to specialist data-analysis and writing agents over replayable, event-sourced sessions, with token streaming served by a dedicated Lambda response-streaming service.",
    href: "https://www.nj.gov/dca/",
  },
  {
    index: "N02",
    title: "PR Review Agent",
    tagline: "Vercel's open-agents framework, adapted to AWS.",
    year: "2026",
    role: "NJ DCA · Engineering",
    stack: ["open-agents", "Bedrock", "Postgres", "SSE"],
    summary:
      "An autonomous GitHub pull-request reviewer built by forking Vercel's open-agents framework and re-platforming its runtime on AWS. Run state lives in Postgres with a gapless per-run event history sequenced under advisory locks and streamed to a live dashboard over resumable SSE via LISTEN/NOTIFY. An EventBridge watchdog claims runs whose event stream goes stale and resumes them from event-sourced state, and /retry re-runs failed reviews seeded with the prior attempt's context.",
    href: "https://www.nj.gov/dca/",
  },
  {
    index: "N03",
    title: "Parsertime",
    tagline: "Open-source analytics SaaS for Overwatch 2.",
    year: "2023 —",
    role: "Founder · Engineering",
    stack: ["Next.js", "Postgres", "LightGBM", "Stripe"],
    summary:
      "A full-stack TypeScript SaaS for Overwatch teams to track scrimmage stats, now at 2,000+ users — processing 21 million+ stats across 430 teams. Runs pre-release Next.js 16 with Cache Components, a win-probability pipeline (per-mode LightGBM models retrained weekly by a cron-triggered Vercel Python function, served by dependency-free TypeScript tree inference), and a computer-vision pipeline that reconstructs match state from gameplay video.",
    href: "https://parsertime.app",
    caseStudyHref: "https://lux.dev/work/parsertime",
  },
  {
    index: "N04",
    title: "NJ Eviction Guide",
    tagline: "Multilingual legal aid, rewritten to Next.js.",
    year: "2025 —",
    role: "NJ DCA · Engineering",
    stack: ["Next.js", "shadcn/ui", "i18n"],
    summary:
      "Led the V2 rewrite from Vite/React to Next.js + shadcn/ui, including go-live readiness and pre-launch SEO wiring via Google Search Console and Bing Webmaster Tools. Built an i18n framework under the NJ Language Access Mandate and a CI/CD pipeline that converts localization messages from JSON to PO, giving non-technical translators a Poedit workflow.",
    href: "https://www.nj.gov/dca/",
  },
  {
    index: "N05",
    title: "Code Interpreter",
    tagline: "A tree-walking interpreter in Go and Rust.",
    year: "2023",
    role: "Solo · Systems",
    stack: ["Go", "Rust", "Pratt Parser", "REPL"],
    summary:
      "A small programming language built end-to-end: lexer and tokenizer in Go and Rust, a Pratt parser emitting an AST, and a recursive tree-walking evaluator. Ships with an interactive REPL. Written to understand the moving parts of a language implementation from first principles rather than reach for a parser generator.",
    href: "https://github.com/lucasdoell",
  },
  {
    index: "N06",
    title: "CaffTrack",
    tagline: "Caffeine intake, identified by computer vision.",
    year: "2025",
    role: "Hackathon · 3-person team",
    stack: ["Vite", "React", "Django", "Gemini"],
    summary:
      "Built in 36 hours at Cornell's Big Red Makeathon. Photograph a drink; a vision model identifies it, logs caffeine load, and plots tolerance over time. Cloudflare R2 for image storage, Django on the backend. Awarded Best Software.",
    href: "https://github.com/lucasdoell/cafftrack",
  },
];
---

<section
  id="work"
  class:list={[
    "relative w-full",
    "px-6 sm:px-10 lg:px-14",
    "pt-24 sm:pt-32",
    "pb-24 sm:pb-32",
    className,
  ]}
  aria-labelledby="work-heading"
>
  <header class="mb-14 sm:mb-20">
    <div class="flex items-baseline justify-between gap-6 mb-6">
      <span class="meta">§ 01 &nbsp;&mdash;&nbsp; Selected Work</span>
      <span class="meta">
        <span style="color: var(--color-fg-mute);">Count</span>
        <span class="ml-1.5" style="color: var(--color-fg);">{projects.length.toString().padStart(2, "0")}</span>
      </span>
    </div>
    <hr class="rule" />
    <h2
      id="work-heading"
      class="display mt-8 sm:mt-10"
      style="
        font-size: var(--text-display-sm);
        font-weight: 480;
        max-width: 18ch;
      "
    >
      Recent work.
    </h2>
  </header>

  <ol class="work-list">
    {
      projects.map((p) => (
        <li class="work-row group">
          <a
            class="work-row__link"
            href={p.caseStudyHref ?? p.href}
            target={p.caseStudyHref ? "_self" : "_blank"}
            rel={p.caseStudyHref ? undefined : "noreferrer"}
            aria-label={`${p.title} — ${p.tagline}`}
          >
            <span class="work-row__index meta">{p.index}</span>

            <div class="work-row__body">
              <h3 class="work-row__title display">
                {p.title}
              </h3>
              <p class="work-row__tag">{p.tagline}</p>
              <div class="work-row__meta">
                <span class="meta">{p.role}</span>
                <span class="meta" aria-hidden="true">·</span>
                <span class="meta">{p.stack.join(" · ")}</span>
              </div>
              <p class="work-row__summary">{p.summary}</p>
            </div>

            <span class="work-row__year meta">{p.year}</span>
          </a>
        </li>
      ))
    }
  </ol>

  <footer class="mt-16 sm:mt-24 flex items-end justify-between gap-6">
    <p
      class="max-w-[42ch]"
      style="font-size: var(--text-caption); color: var(--color-fg-soft);"
    >
      Full source, demos, and side projects on
      <a
        href="https://github.com/lucasdoell"
        target="_blank"
        rel="noreferrer"
        class="ink-link"
      >GitHub</a>.
    </p>
    <span class="meta">End · § 01</span>
  </footer>
</section>

<style>
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }

  .work-row {
    border-bottom: 1px solid var(--color-rule);
    position: relative;
  }

  .work-row__link {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    column-gap: clamp(1.25rem, 3vw, 3rem);
    row-gap: 0.5rem;
    align-items: baseline;
    padding: clamp(1.5rem, 4vw, 3rem) 0;
    position: relative;
    isolation: isolate;
    transition: color 360ms ease;
  }

  .work-row__index {
    color: var(--color-fg-mute);
    align-self: start;
    padding-top: 0.75rem;
    transition: color 360ms ease;
  }

  .work-row__body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .work-row__title {
    font-size: clamp(2rem, 6.5vw, 4.75rem);
    line-height: 0.95;
    font-weight: 480;
    color: var(--color-fg);
    letter-spacing: var(--tracking-display);
    transition: color 360ms ease, transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .work-row__tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.0625rem, 1.3vw + 0.75rem, 1.375rem);
    line-height: 1.3;
    color: var(--color-fg-soft);
    max-width: 42ch;
  }

  .work-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  .work-row__year {
    align-self: start;
    padding-top: 1rem;
    color: var(--color-fg-mute);
    white-space: nowrap;
  }

  .work-row__summary {
    max-width: 58ch;
    font-size: var(--text-body);
    color: var(--color-fg-soft);
    line-height: 1.55;
    margin-top: 0.35rem;
  }

  .work-row:hover .work-row__title,
  .work-row:focus-within .work-row__title {
    transform: translateX(8px);
  }

  .work-row:hover .work-row__index,
  .work-row:focus-within .work-row__index {
    color: var(--color-accent);
  }

  /* `hover: hover` — touch devices don't have hover, so keep the summary
     visible there regardless of width. */
  @media (hover: hover) and (min-width: 768px) {
    .work-row__summary {
      max-height: 0;
      opacity: 0;
      transform: translateY(-4px);
      overflow: hidden;
      margin-top: 0;
      transition:
        max-height 620ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 380ms ease,
        transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
        margin-top 400ms ease;
    }
    .work-row:hover .work-row__summary,
    .work-row:focus-within .work-row__summary {
      max-height: 12rem;
      opacity: 1;
      transform: translateY(0);
      margin-top: 0.35rem;
    }
  }

  @media (max-width: 640px) {
    .work-row__link {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      row-gap: 0.75rem;
    }
    .work-row__body {
      grid-column: 1 / -1;
    }
    .work-row__index {
      padding-top: 0;
      grid-column: 1;
      grid-row: 1;
    }
    .work-row__year {
      padding-top: 0;
      grid-column: 2;
      grid-row: 1;
      text-align: right;
      justify-self: end;
    }
  }
</style>
