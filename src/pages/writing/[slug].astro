---
import { render } from "astro:content";
import Nav from "../../components/Nav.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getPosts, readingTime, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, next: posts[i + 1] } }));
}

interface Props {
  post: Post;
  next?: Post;
}
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
const contents = headings.filter((h) => h.depth === 2 && h.slug !== "footnote-label");
---

<Layout title={`${post.data.title} — Lucas Doell`} description={post.data.description}>
  <Nav slot="top" />
  <article class="post">
    <header class="post__head wrap">
      <a class="meta meta--muted post__back" href="/writing">← Writing</a>
      <div class="post__headmain">
        <span class="meta meta--muted">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.topic && <> &nbsp; {post.data.topic}</>} · {readingTime(post.body)} min read
        </span>
        <h1 class="post__title">{post.data.title}</h1>
        <p class="post__dek">{post.data.description}</p>
      </div>
    </header>

    <div class="post__grid wrap">
      <aside class="post__rail">
        {
          contents.length > 0 && (
            <nav class="toc" aria-label="Contents">
              <span class="meta meta--muted">Contents</span>
              <ol>
                {contents.map((h, i) => (
                  <li>
                    <a href={`#${h.slug}`}>
                      <span class="toc__n">{String(i + 1).padStart(2, "0")} ·</span> {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="post__end wrap">
      <div class="post__thanks">
        <span class="meta meta--muted">Thanks for reading</span>
        <a class="meta meta--accent" href="mailto:lucas@lux.dev">lucas@lux.dev</a>
      </div>
      {
        next ? (
          <a class="post__next" href={`/writing/${next.id}`}>
            <span class="meta meta--muted">Next post</span>
            <span class="post__nexttitle">{next.data.title} →</span>
          </a>
        ) : (
          <a class="post__next" href="/writing">
            <span class="meta meta--muted">More writing</span>
            <span class="post__nexttitle">All posts →</span>
          </a>
        )
      }
    </footer>
  </article>
</Layout>

<style>
  .post__head {
    display: grid;
    grid-template-columns: var(--label-col) minmax(0, 1fr);
    column-gap: var(--col-gap);
    padding-top: 104px;
    padding-bottom: 72px;
    position: relative;
  }
  .post__head::after {
    content: "";
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    border-bottom: 1px solid var(--line);
  }
  .post__headmain {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 760px;
  }
  .post__title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(44px, 5vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .post__dek {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 24px;
    line-height: 32px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .post__grid {
    display: grid;
    grid-template-columns: var(--label-col) minmax(0, 1fr);
    column-gap: var(--col-gap);
    padding-top: 64px;
  }
  .toc {
    position: sticky;
    top: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 20px;
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--fg);
  }
  .toc__n {
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .prose {
    max-width: 680px;
    font-size: 17px;
    line-height: 29px;
  }
  .prose :global(p) {
    margin: 0 0 24px;
    text-wrap: pretty;
  }
  .prose :global(h2) {
    counter-increment: h2;
    margin: 56px 0 20px;
    font-weight: 500;
    font-size: 28px;
    line-height: 34px;
    letter-spacing: -0.02em;
  }
  .prose {
    counter-reset: h2;
  }
  .prose :global(h2)::before {
    content: counter(h2, decimal-leading-zero) " · ";
  }
  .prose :global(h3) {
    margin: 40px 0 12px;
    font-weight: 500;
    font-size: 20px;
    line-height: 28px;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose :global(blockquote) {
    margin: 40px 0;
    padding-left: 24px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 32px;
    line-height: 40px;
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 24px;
    padding-left: 1.2em;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
  }
  .prose :global(pre) {
    margin: 32px 0;
    padding: 24px 20px;
    border-radius: 6px;
    background: var(--plate) !important;
    color: var(--color-frost);
    overflow-x: auto;
    font-size: 13px;
    line-height: 20px;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 48px 0;
  }
  .prose :global(.footnotes) {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 22px;
    color: var(--muted);
  }

  .post__end {
    display: grid;
    grid-template-columns: var(--label-col) minmax(0, 1fr);
    column-gap: var(--col-gap);
    padding-top: 120px;
    padding-bottom: 96px;
  }
  .post__thanks {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .post__next {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line-strong);
  }
  .post__nexttitle {
    font-weight: 500;
    font-size: clamp(30px, 3vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .post__next:hover .post__nexttitle {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .post__head,
    .post__grid,
    .post__end {
      grid-template-columns: 1fr;
      row-gap: 32px;
    }
    .post__head {
      padding-top: 64px;
    }
    .post__rail {
      display: none;
    }
    .post__grid {
      padding-top: 40px;
    }
  }
</style>
