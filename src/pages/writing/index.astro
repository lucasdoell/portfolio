---
import Nav from "../../components/Nav.astro";
import Star from "../../components/Star.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getPosts, readingTime } from "../../lib/posts";

const posts = await getPosts();
---

<Layout title="Writing — Lucas Doell" description="Notes on agents, tools, and the decisions behind them.">
  <Nav slot="top" />
  <header class="whead wrap">
    <h1 class="whead__title">Writing</h1>
    <div class="whead__side">
      <p class="whead__lede">Notes on agents, tools, and the decisions behind them.</p>
      <div class="whead__meta">
        <span class="meta meta--muted">
          {posts.length === 0 ? "No posts yet" : `${posts.length} ${posts.length === 1 ? "post" : "posts"}`}
        </span>
        <a class="meta meta--accent" href="/rss.xml">RSS ↗</a>
      </div>
    </div>
  </header>

  {
    posts.length === 0 ? (
      <section class="empty wrap">
        <div class="empty__mark">
          <Star size={24} />
        </div>
        <div class="empty__body">
          <p class="empty__title">The first post is still being written.</p>
          <p class="empty__note">
            Subscribe to the feed and it will show up in your reader when it lands. No newsletter, no schedule.
          </p>
          <div class="empty__links">
            <a class="meta meta--accent" href="/rss.xml">
              Subscribe via RSS ↗
            </a>
            <a class="meta" href="/#work">
              Back to the logbook
            </a>
          </div>
        </div>
      </section>
    ) : (
      <ol class="archive wrap">
        {posts.map((p) => (
          <li>
            <a class="archive__row" href={`/writing/${p.id}`}>
              <span class="meta meta--muted">
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                {p.data.topic && <> · {p.data.topic}</>} · {readingTime(p.body)} min read
              </span>
              <span class="archive__text">
                <span class="archive__title">{p.data.title}</span>
                <span class="archive__desc">{p.data.description}</span>
              </span>
              <span class="meta meta--accent">Read →</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Layout>

<style>
  .whead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 64px;
    padding-top: 120px;
  }
  .whead::after {
    content: none;
  }
  .whead {
    position: relative;
    padding-bottom: 56px;
  }
  .whead::before {
    content: "";
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .whead__title {
    margin: 0 0 0 -0.04em;
    font-weight: 500;
    font-size: clamp(88px, 13.9vw, 200px);
    line-height: 0.84;
    letter-spacing: -0.055em;
  }
  .whead__side {
    width: 420px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 6px;
  }
  .whead__lede {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 26px;
    line-height: 34px;
  }
  .whead__meta {
    display: flex;
    gap: 24px;
  }

  .empty {
    display: grid;
    grid-template-columns: var(--label-col) minmax(0, 1fr);
    column-gap: var(--col-gap);
    padding-top: 72px;
    padding-bottom: 240px;
  }
  .empty__body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .empty__title {
    margin: 0;
    max-width: 760px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(36px, 3.3vw, 48px);
    line-height: 1.17;
    letter-spacing: -0.01em;
  }
  .empty__note {
    margin: 0;
    max-width: 560px;
    font-size: 18px;
    line-height: 30px;
    color: var(--muted);
  }
  .empty__links {
    display: flex;
    gap: 28px;
    padding-top: 8px;
  }

  .archive {
    list-style: none;
    margin: 0;
    padding-bottom: 160px;
  }
  .archive__row {
    display: grid;
    grid-template-columns: var(--label-col) minmax(0, 1fr) auto;
    column-gap: var(--col-gap);
    align-items: baseline;
    padding-block: 32px;
    border-bottom: 1px solid var(--line);
  }
  .archive__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .archive__title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(26px, 2.2vw, 32px);
    line-height: 1.25;
  }
  .archive__desc {
    color: var(--muted);
    font-size: 15px;
    line-height: 22px;
  }
  .archive__row:hover .archive__title {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .whead {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding-top: 72px;
    }
    .whead__side {
      width: auto;
    }
    .empty,
    .archive__row {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }
    .empty {
      padding-bottom: 120px;
    }
  }
</style>
